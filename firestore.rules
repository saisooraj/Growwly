rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: requesting user owns the doc
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Transactions
    match /transactions/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Budgets  (id format: userId_month_category)
    match /budgets/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Projects
    match /projects/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Borrowings
    match /borrowings/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Emergency Fund (doc id = userId)
    match /emergencyFunds/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User Settings (doc id = userId)
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Upcoming Expenses
    match /upcoming/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Savings Goals
    match /savingsGoals/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Push Subscriptions (doc id = userId)
    match /pushSubscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Upcoming Payments
    match /upcomingPayments/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Assets
    match /assets/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Liabilities
    match /liabilities/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // User profile (privacy consent, etc.) — doc id = userId
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Contacts
    match /contacts/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // User profiles — written by AuthContext on every sign-in (doc id = userId)
    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Admin alerts — auth error logs written by client before sign-in completes.
    // Anyone can create (pre-auth logging), only admin can read and mark as read.
    match /adminAlerts/{docId} {
      allow create: if true;
      allow read, update: if isAuth() && request.auth.token.email == 'saisoorajpnair@gmail.com';
    }

    // Announcement events — impression/click/dismiss analytics for in-app tours & nudges.
    // Users can only log events for themselves; only admin can read the analytics.
    match /announcement_events/{docId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && request.auth.token.email == 'saisoorajpnair@gmail.com';
    }

    // Tasks
    match /tasks/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Health Routines
    match /healthRoutines/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Health Logs (doc id = userId_date_routineId)
    match /healthLogs/{docId} {
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
